+/* Local patch 0019 (lean timing): the interrupt check's fast path inline at every call site (generated code checks at
+ * each block boundary; the dispatch-entry check stays a call, the generated dispatcher declares it itself): nothing to do while no device event is due, no interrupt COP0 would take is pending, and no
+ * exception or deferred thread switch is in progress (the same test psx_check_interrupts_at begins with, patch 0011);
+ * otherwise the call. interrupts.c defines the functions themselves (PSXRECOMP_INTERRUPTS_IMPL). */
+#if defined(PSX_LEAN_TIMING) && !defined(PSX_COSIM) && !defined(PSXRECOMP_INTERRUPTS_IMPL) && !defined(PSX_OVERLAY_DLL_BUILD)
+#include "cpu_state.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern uint64_t psx_cycle_count, psx_next_service_cycle;
+extern uint32_t g_psx_cyc_batch;
+extern uint32_t i_stat, i_mask;
+extern int psx_lean_in_exception, psx_lean_defer_switch_pending;
+static inline int psx_interrupts_quiet(const struct CPUState* cpu) {
+    const uint32_t sr = cpu->cop0[12];
+    return psx_cycle_count + g_psx_cyc_batch < psx_next_service_cycle && !psx_lean_in_exception &&
+           !psx_lean_defer_switch_pending && (cpu->cop0[13] & sr & 0x300u) == 0u &&
+           ((i_stat & i_mask) == 0u || (sr & 0x401u) != 0x401u);
+}
+static inline void psx_check_interrupts_at_inline(struct CPUState* cpu, uint32_t resume_pc) {
+    if (!psx_interrupts_quiet(cpu)) (psx_check_interrupts_at)(cpu, resume_pc);
+}
+#ifdef __cplusplus
+}
+#endif
+#define psx_check_interrupts_at(cpu, pc) psx_check_interrupts_at_inline((cpu), (pc))
+#endif
+
 #endif /* PSXRECOMP_INTERRUPTS_H */
