+void spu_native_audio_on(void) { spu_native_mode = 1; }
+int spu_native_audio(void) { return spu_native_mode; }
+
+void spu_mix_for_device(int16_t* out_stereo, int frames) {
+    spu_in_mixer = 1;
+    while (frames > 0) {
+        const int chunk = frames > 64 ? 64 : frames;	/* the lock let go between: the game's thread waits for one at most */
+        {
+            SPU_LOCKED;
+            spu_render(out_stereo, chunk);
+            spu_mixed += (unsigned long long)chunk;
+        }
+        out_stereo += chunk * 2;
+        frames -= chunk;
+    }
+}
+
+void spu_deliver_mixer_irq(void) {
+    const uint32_t irq = __atomic_exchange_n(&spu_mixer_irq, 0u, __ATOMIC_ACQ_REL);
+    if (irq != 0u)
+        psx_irq_raise(9u, irq & ~1u);
+}
+
+void spu_cd_mix_set(uint8_t l_to_l, uint8_t l_to_r, uint8_t r_to_l, uint8_t r_to_r, int muted) {
+    cd_mix[0] = l_to_l, cd_mix[1] = l_to_r, cd_mix[2] = r_to_l, cd_mix[3] = r_to_r;
+    cd_mix_muted = muted;
+}
+
+double spu_cd_pace(void) {
+    if (!spu_native_mode) return 1.0;
+    const double held = (double)__atomic_load_n(&cd_frame_count, __ATOMIC_RELAXED);
+    const double pace = 1.0 + 0.5 * ((double)CD_TARGET_FRAMES - held) / (double)CD_TARGET_FRAMES;
+    return pace < 0.8 ? 0.8 : pace > 1.5 ? 1.5 : pace;
+}
+
+uint32_t spu_cd_audio_fill(void) { return __atomic_load_n(&cd_frame_count, __ATOMIC_RELAXED); }
+uint64_t spu_cd_audio_underflows(void) { return cd_underflow_events; }
+uint64_t spu_cd_audio_overflows(void) { return cd_overflow_frames; }
+unsigned long long spu_mixed_frames(void) { return spu_mixed; }
