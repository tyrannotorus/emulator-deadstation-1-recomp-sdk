+/* mkdir -p without a shell: create each '/'- or '\\'-separated prefix of `path`. */
+static void overlay_dump_mkdirs(const char *path)
+{
+    char buf[512];
+    size_t n = strlen(path);
+    if (n == 0 || n >= sizeof(buf)) return;
+    memcpy(buf, path, n + 1);
+    for (size_t i = 1; i <= n; ++i) {
+        if (buf[i] != '/' && buf[i] != '\\' && buf[i] != '\0') continue;
+        char c = buf[i];
+        buf[i] = '\0';
+#ifdef _WIN32
+        _mkdir(buf);
+#else
+        mkdir(buf, 0755);
+#endif
+        buf[i] = c;
+    }
+}
