+/* Local patch 0017: bytes of disc data from lba on, 2048 a sector, into guest RAM at dest, written as the CD DMA writes
+ * them (each word through the RAM path, code pages marked, overlay capture told), with no drive, interrupt or DMA:
+ * a host's native disc loader. Each sector's last partial word is not written (as a word DMA of bytes / 4). 0: a sector
+ * could not be read. */
+int psx_cdrom_read_user_sector(uint32_t lba, uint8_t *out);
+int psx_native_cd_read(uint32_t lba, uint32_t dest, uint32_t bytes) {
+    extern uint8_t *memory_get_ram_ptr(void);
+    uint8_t sector[2048];
+    uint32_t addr = DMA_RAM_ADDR(dest);
+    const uint32_t start = addr, total = bytes;
+    if (bytes == 0) return 1;
+    if (addr < psx_ram_live_bytes()) {
+        uint32_t span = bytes;
+        if (span > psx_ram_live_bytes() - addr) span = psx_ram_live_bytes() - addr;
+        overlay_capture_before_dma(addr, span);
+    }
+    while (bytes > 0) {
+        const uint32_t n = bytes < 2048u ? bytes : 2048u;
+        if (!psx_cdrom_read_user_sector(lba, sector)) return 0;
+        for (uint32_t i = 0; i + 4u <= n; i += 4u) {
+            uint32_t word;
+            memcpy(&word, sector + i, 4);
+            psx_write_word(DMA_RAM_ADDR(addr + i), word);
+        }
+        dirty_ram_mark_executable_range(addr, n & ~3u);
+        addr = DMA_RAM_ADDR(addr + 2048u);
+        bytes -= n;
+        lba++;
+    }
+    if (start < psx_ram_live_bytes()) {
+        uint32_t span = total;
+        if (span > psx_ram_live_bytes() - start) span = psx_ram_live_bytes() - start;
+        overlay_capture_on_dma(start, span, memory_get_ram_ptr() + start);
+    }
+    return 1;
+}
