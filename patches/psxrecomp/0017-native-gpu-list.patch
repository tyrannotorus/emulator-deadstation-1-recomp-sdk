+uint32_t psx_native_gpu_list(uint32_t addr) {
+    static const DMAGPULinkedListOps ops = {
+        gpu_ll_resolve_address,
+        gpu_ll_read_word,
+        gpu_ll_observe_header,
+        gpu_ll_begin_node,
+        gpu_ll_emit_word,
+        native_list_complete
+    };
+    DMAGPULinkedList list;
+    memset(&list, 0, sizeof(list));
+    dma_gpu_ll_start(&list, psx_mod_gpu_dma_resolve_address(addr & 0x00FFFFFFu), 0x40000u);
+    while (list.active)
+        dma_gpu_ll_advance(&list, UINT32_MAX, &ops, NULL);
+    return list.total_words;
+}
