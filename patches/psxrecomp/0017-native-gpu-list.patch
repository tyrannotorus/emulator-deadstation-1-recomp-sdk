+/* Local patch 0017: one sector's 2048 user bytes from the disc image (as a read would leave them in RAM), for a host
+ * that replaces a game's disc loader (Deadstation's native SDK, recomp/brick/psx_sdk.cpp). 0: no disc or no sector. */
+int psx_cdrom_read_user_sector(uint32_t lba, uint8_t *out) {
+    uint8_t raw[RAW_SECTOR_SIZE];
+    if (!iso_handle) return 0;
+    if (iso_read_raw_sector(iso_handle, lba, raw, RAW_SECTOR_SIZE)) {
+        memcpy(out, raw + RAW_USER_DATA_OFFSET, SECTOR_SIZE);
+        return 1;
+    }
+    return iso_read_sector(iso_handle, lba, out, SECTOR_SIZE);
+}
