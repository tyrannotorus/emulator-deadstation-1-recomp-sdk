+    } else {
+        const uint32_t* ranges = 0;
+        uint32_t count = 0;
+        PsxGameEntryFn found = psx_game_entry_lookup(addr, &resume, &ranges, &count);
+        if (!found) return 0;
+        g_text_last_ok_clean = 0;
+        if (!dirty_ram_text_native_ok_ranges_from(ranges, count, addr)) return 0;
+        if (g_text_last_ok_clean) {
+            s_fast[ci].addr = addr, s_fast[ci].epoch = g_text_clean_epoch;
+            s_fast[ci].resume = resume, s_fast[ci].fn = found;
+        }
