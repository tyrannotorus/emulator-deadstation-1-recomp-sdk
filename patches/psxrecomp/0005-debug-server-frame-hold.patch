+/* frame_hold (local patch 0005): park the emu thread at the vblank where the frame
+ * counter reaches s_hold_frame, still serving commands, so a client can read a frame's
+ * exact state; moving the hold frame forward releases it. 0 = off. */
+static volatile uint64_t s_hold_frame = 0;
+
 void debug_server_wait_if_paused(void)
 {
-    /* No-op: pause/step removed (see handle_pause). Kept exported so
-     * main.cpp's vblank callback continues to compile without
-     * conditional defines. s_paused is now permanently zero, so the
-     * old `while (s_paused)` loop would have been a no-op anyway. */
+    while (s_hold_frame != 0 && s_frame_count >= s_hold_frame) {
+        debug_server_poll();
+        SDL_Delay(1);
+    }
+}
+
+static void handle_fn_hold(int id, const char *json)
+{
+    char addr_str[32];
+    if (json_get_int(json, "release", 0)) s_fn_held = 0;
+    if (json_get_str(json, "addr", addr_str, sizeof(addr_str))) {
+        int nth = json_get_int(json, "nth", 1);
+        s_hold_fn_left = nth < 1 ? 1 : nth;
+        s_hold_fn = hex_to_u32(addr_str);
+    }
+    send_fmt("{\"id\":%d,\"ok\":true,\"armed\":\"0x%08X\",\"held\":%d,\"frame\":%llu}",
+             id, s_hold_fn, s_fn_held, (unsigned long long)s_frame_count);
+}
+
+static void handle_frame_hold(int id, const char *json)
+{
+    int frame = json_get_int(json, "frame", -1);
+    if (frame >= 0) s_hold_frame = (uint64_t)frame;
+    send_fmt("{\"id\":%d,\"ok\":true,\"hold_frame\":%llu,\"cur_frame\":%llu,\"held\":%d}",
+             id, (unsigned long long)s_hold_frame, (unsigned long long)s_frame_count,
+             (s_hold_frame != 0 && s_frame_count >= s_hold_frame) ? 1 : 0);
 }
 
