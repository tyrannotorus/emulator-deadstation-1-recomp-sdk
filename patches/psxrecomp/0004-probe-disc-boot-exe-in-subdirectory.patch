+def parse_system_cnf_dirs(cnf: bytes) -> list[str]:
+    """Directories on the BOOT= path, e.g. ['GAME'] for cdrom:\\GAME\\SLUS_000.00;1."""
+    text = cnf.decode("ascii", "replace")
+    m = re.search(r"BOOT\s*=\s*cdrom:\\?([^;\s]+)", text, re.I)
+    if not m:
+        return []
+    return [part for part in re.split(r"[\\/]", m.group(1).strip())[:-1] if part]
+
+
 def normalize_serial(boot_exe: str) -> tuple[str, str]:
